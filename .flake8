[flake8]
exclude = .git,__pycache__,migrations,venv,static/CACHE,node_modules,docs,env
max-line-length = 99
# E203: whitespace before ':' (often conflicts with black)
# W503: line break before binary operator (often conflicts with black)
# E501: line too long (handled by black, but good to have for flake8 awareness if not using black)
# W291: trailing whitespace (black usually handles this)
# W292: no newline at end of file (black usually handles this)
# W293: blank line contains whitespace (black usually handles this)
ignore = E203, W503
# Recommended by some to also ignore E121, E123, E126, E226, E24, E704 if using black
# For now, starting with minimal ignores.
# Add flake8-django specific settings if any (usually not needed for basic setup)

# General Settings
DJANGO_SECRET_KEY="your-development-secret-key-here-please-change-me"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings (SQLite for dev, PostgreSQL for prod example)
DATABASE_URL=sqlite:///db.sqlite3
# Example for PostgreSQL:
# DATABASE_URL=postgres://your_db_user:your_db_password@your_db_host:5432/your_db_name

# Email Settings (using console backend for dev by default in settings.py)
# For actual email sending, you might need:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=webmaster@localhost

# Cloudinary/Cloud Storage (if used for media files)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Other service keys
# SOME_OTHER_API_KEY=
